  "notes": [
    {"topic": "Lantai & level", "items": ["Lantai dalam rumah ±10–15 cm lebih tinggi dari deck dan taman, supaya air hujan tidak masuk lewat pintu taman.", "Deck kayu menerus dari ujung roster sampai area wudhu, lalu ke pintu musholla (P11)."]},
    {"topic": "Pintu taman PL1", "items": ["Sliding aluminium slim frame hitam doff, kaca polos: 2 kaca mati di rel luar, 2 daun geser di rel dalam.", "Ambang bawah dengan lubang buang air (weep hole); kunci tanam + grendel atas-bawah."]},
    {"topic": "Musholla", "items": ["Dak beton biasa dengan skylight 1 garis ±30 cm menempel dinding kiblat: kaca laminated + film penahan panas, bibir beton keliling.", "Dinding kiblat sisi service yard: roster 12–20 cm (lubang miring/bertingkat) + kaca mati buram di sisi dalam; sisi dapur tetap masif dengan panel mihrab.", "Arah kiblat: sajadah diputar ±25° dari dinding barat (cek ulang dengan kompas kiblat di lokasi)."]},
    {"topic": "Taman & privasi", "items": ["Roster di depan taman: dinding masif 60 cm + roster sampai bawah kanopi carport (±2,8 m).", "Kanopi kaca di atas deck: tempered laminated dengan rangka hitam dan kisi kayu di bawahnya."]},
    {"topic": "Dapur", "items": ["Kitchen set bentuk L tanpa island; jendela J1 di atas sink, dinding di atas kompor untuk cooker hood + cerobong.", "Meja makan di tengah (85 × 120 cm, 4 kursi) sekaligus meja bantu masak; lemari pantry tinggi + kabinet bawah/atas di dinding musholla."]},
    {"topic": "Kamar mandi & pintu", "items": ["KM tamu: daun pintu P4 buka keluar (ruangnya 1 × 1,5 m); kloset menghadap selatan, tidak menghadap kiblat.", "Semua pintu engsel dicek bebas halangan 80 cm di depannya; arah buka sesuai denah."]},
    {"topic": "Kamar", "items": ["Kamar 2 dan 3: kasur 160 × 200, lemari 150 cm; sandaran kasur 85 cm supaya tidak menutup ambang jendela samping (90 cm)."]},
    {"topic": "Tangga", "items": ["Tangga melayang seperempat putaran: 9 anak tangga + bordes + 5 anak tangga; railing di sisi void lantai 2.", "Bawah bordes: lemari ±0,8 × 0,9 m, tinggi ±1,6 m, pintu P13 dari studio. Bawah anak tangga: 2 laci tarik beroda yang ditarik ke lemari genkan. Dinding di bawah garis tangga bukan dinding struktur: tangga ditumpu dinding barat atau balok besi (dihitung kontraktor)."]}
  ],

